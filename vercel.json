{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/unit-4/project-2",
      "destination": "/unit-4/project-2/index.html"
    },
    {
      "source": "/unit-4/project-2/(.*)",
      "destination": "/unit-4/project-2/index.html"
    },
    {
      "source": "/unit-5/project-1",
      "destination": "/unit-5/project-1/index.html"
    },
    {
      "source": "/unit-5/project-1/(.*)",
      "destination": "/unit-5/project-1/index.html"
    },
    {
      "source": "/unit-5/project-2",
      "destination": "/unit-5/project-2/index.html"
    },
    {
      "source": "/unit-5/project-2/(.*)",
      "destination": "/unit-5/project-2/index.html"
    }
  ]
}